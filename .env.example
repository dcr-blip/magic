# Copy this file to .env and fill in your values.

# --- Required for AI agent mode (discord_bot.py, main.py) ---
# NOT required for scraper_bot.py or main.py --scrape
ANTHROPIC_API_KEY=your_api_key_here

# --- Required for Discord bots (discord_bot.py or scraper_bot.py) ---
# Get one at https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# --- Optional settings ---

# Change the bot command prefix (default: !agent)
# BOT_PREFIX=!agent

# Use cheapest Claude model (Haiku) instead of Sonnet for AI agent mode
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# GitHub personal access token for private repos
# GITHUB_TOKEN=ghp_your_token_here

# Auto-post scrape results to this Discord channel (scraper_bot.py only)
# SCRAPE_CHANNEL_ID=123456789
# SCRAPE_INTERVAL_HOURS=12
